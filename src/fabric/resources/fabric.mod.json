{
  "schemaVersion": 1,
  "id": "discordlinkplus_voice",
  "version": "${version}",
  "name": "DiscordLink+ Voice (Fabric port)",
  "description": "Temporary two-way Discord voice channels for non-isolated Simple Voice Chat groups.",
  "authors": [
    "DiscordLink+ upstream: codingsushi79",
    "Axolotl Fabric voice port"
  ],
  "environment": "server",
  "entrypoints": {
    "main": [
      "com.mcdiscordbot.fabric.DiscordVoiceMod"
    ],
    "voicechat": [
      "com.mcdiscordbot.fabric.SvcPlugin"
    ]
  },
  "depends": {
    "fabricloader": ">=${loaderVersion}",
    "minecraft": "${minecraftVersion}",
    "java": ">=${javaVersion}",
    "fabric-api": "*",
    "voicechat": "${voicechatVersion}"
  }
}
